+# Locating GCC/Linux system paths for an external Clang without hardcoding versions
+if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+    execute_process(
+        COMMAND sh -c "g++ -dumpversion"
+        OUTPUT_VARIABLE SYS_GCC_VERSION
+        OUTPUT_STRIP_TRAILING_WHITESPACE
+        ERROR_QUIET
+    )
+    execute_process(
+        COMMAND sh -c "uname -m"
+        OUTPUT_VARIABLE SYS_ARCH
+        OUTPUT_STRIP_TRAILING_WHITESPACE
+        ERROR_QUIET
+    )
+    if(SYS_GCC_VERSION AND SYS_ARCH)
+        set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -isystem /usr/lib/gcc/${SYS_ARCH}-linux-gnu/${SYS_GCC_VERSION}/include -isystem /usr/include/${SYS_ARCH}-linux-gnu")
+    endif()
+endif()
+
